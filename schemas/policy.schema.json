{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://literal.local/schemas/policy.schema.json",
  "title": "Literal Policy",
  "type": "object",
  "properties": {
    "fuzzy_cutoff": {"type": "number", "minimum": 0, "maximum": 1},
    "inspect_verbs": {"type": "array", "items": {"type": "string"}},
    "scenario_verbs": {"type": "array", "items": {"type": "string"}},
    "synonyms": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "confirmations": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "deny": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "rule": {
      "type": "object",
      "properties": {
        "target": {"type": "string"},
        "action": {"type": "string"},
        "reason": {"type": "string"}
      }
    }
  }
}
